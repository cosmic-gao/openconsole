{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@openconsole/tsconfig/lib", "@openconsole/tsconfig/esm"],
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
