# opencode 大脑
OPENCODE_BASE_URL=http://localhost:4096

# Deepgram（STT / TTS / 实时 Voice Agent 都用这把 key 签发临时令牌）
DEEPGRAM_API_KEY=

# 文字聊天默认模型
CHAT_MODEL=openai/gpt-4o-mini

# ── 实时语音（/voice，Deepgram Voice Agent，think 回调 opencode） ──
# Deepgram 云端需公网回调 think 端点；本地用隧道：`ngrok http 3000`，把外网根地址填这里
VOICE_THINK_PUBLIC_URL=http://115.190.150.206:7000
# think 端点共享密钥（可选）：留空则不校验
VOICE_THINK_TOKEN=
# opencode 侧 agent 名（见 opencode.json）
VOICE_AGENT=voice
# 语言与音色（默认英文，开箱即用）
VOICE_LANGUAGE=en
VOICE_STT_MODEL=nova-3
VOICE_TTS_MODEL=aura-2-thalia-en
VOICE_GREETING=Hello, this is technical support. How can I help you today?
# 双模型：前 N 轮用 fast，之后升 smart
VOICE_MODEL_FAST=openai/gpt-4o-mini
VOICE_MODEL_SMART=openai/gpt-4o
VOICE_MODEL_SMART_AFTER=3
