{
  "name": "@openconsole/graph",
  "version": "0.0.1",
  "private": true,
  "description": "类型化端口、Structure 契约、不可变 CSR 与可中断算法的有向图内核",
  "license": "MIT",
  "keywords": [
    "graph",
    "digraph",
    "directed-graph",
    "dag",
    "toposort",
    "dijkstra",
    "scc",
    "csr",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmic-gao/openconsole.git",
    "directory": "packages/graph"
  },
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./algorithm": {
      "types": "./core/algorithm/index.ts",
      "default": "./core/algorithm/index.ts"
    },
    "./serialize": {
      "types": "./core/serialize/index.ts",
      "default": "./core/serialize/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "doc": "typedoc"
  },
  "dependencies": {
    "@openconsole/queue": "workspace:*",
    "@openconsole/signal": "workspace:*"
  },
  "devDependencies": {
    "typedoc": "^0.28.0"
  }
}
