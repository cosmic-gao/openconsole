# 复制为 .env 或在 dockers/aegra 的 .env 里配置(Aegra 容器会读环境变量)。

# ---- LiteLLM 网关(OpenAI 兼容)----
OPENAI_BASE_URL=https://aigateway-sandbox.mspbots.ai/v1
OPENAI_API_KEY=sk-your-litellm-key

# ---- 模型(名字必须是网关已配置的:gemini 系列)----
DEFAULT_MODEL=gemini-3-flash-preview
ANALYSIS_MODEL=gemini-3-pro-preview

# ---- skill 来源:store(热更新,推荐) | filesystem(读本地 skills/)----
SKILL_BACKEND=store
SKILLS_DIR=/app/deepagent/skills
